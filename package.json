{
  "name": "panurgic-flow",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm run test:unit && pnpm run build && node --test tests/rendered-html.test.mjs",
    "codex:forge": "node scripts/panurgic-forge.mjs",
    "codex:forge:dry": "node scripts/panurgic-forge.mjs --dry-run examples/forge-input.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:scan": "node scripts/scan-secrets.mjs",
    "proof:validate": "node scripts/validate-release-claims.mjs",
    "test:unit": "node --test tests/panurgic-core.test.mjs tests/panurgic-storage.test.mjs",
    "test:smoke": "node tests/live-smoke.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "4.10.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
